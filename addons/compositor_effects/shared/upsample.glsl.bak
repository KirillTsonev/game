#[compute]
#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba16f, set = 0, binding = 0) uniform restrict readonly image2D source_img;
layout(rgba16f, set = 1, binding = 0) uniform restrict writeonly image2D dest_img;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dest_size = imageSize(dest_img);
    if (coord.x >= dest_size.x || coord.y >= dest_size.y) return;

    ivec2 src_size = imageSize(source_img);

    vec2 uv = (vec2(coord) + 0.5) * (vec2(src_size) / vec2(dest_size)) - 0.5;
    vec2 f = fract(uv);
    ivec2 c0 = ivec2(floor(uv));
    ivec2 c1 = c0 + ivec2(1, 1);
    c0 = clamp(c0, ivec2(0), src_size - 1);
    c1 = clamp(c1, ivec2(0), src_size - 1);

    vec4 top = mix(imageLoad(source_img, ivec2(c0.x, c0.y)), imageLoad(source_img, ivec2(c1.x, c0.y)), f.x);
    vec4 bot = mix(imageLoad(source_img, ivec2(c0.x, c1.y)), imageLoad(source_img, ivec2(c1.x, c1.y)), f.x);
    vec4 result = mix(top, bot, f.y);

    imageStore(dest_img, coord, result);
}
